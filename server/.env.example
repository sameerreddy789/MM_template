# Copy to server/.env and fill the values privately. Keep this file secret-free.
PORT=4000
FRONTEND_URL=http://localhost:5173

# Optional explicit guard. Use test with rzp_test_, live with rzp_live_.
# Test payments use testRegistrationOrders/testRegistrations and test-only passes.
PAYMENT_MODE=

# New public orders are closed by default. Open only after live credentials,
# account activation, webhook delivery and the email sender have been confirmed.
# Local test mode permits new orders unless this is explicitly false.
REGISTRATIONS_OPEN=false

# Use a matching test-mode key pair for a real sandbox checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Generate a random signing secret of at least 32 characters.
JWT_SECRET=

# Optional staff-only verification of existing test passes on a live backend.
# Use the JWT_SECRET that issued those test QR codes. Never use test payment
# keys for the public backend or reuse this signing secret for live passes.
GATEKEEPER_TEST_ENABLED=false
TEST_JWT_SECRET=

# inline = this Node server sends the ticket email itself (Gmail SMTP or, when the
#          OAuth values below are set, the Gmail API over HTTPS).
# external = a local Google mail sender consumes the Firestore email queue.
# On Render Free, use inline + the Gmail API OAuth values (SMTP ports are blocked).
TICKET_EMAIL_MODE=inline

# Official sender mailbox (used by both SMTP and Gmail API).
GMAIL_USER=

# SMTP path: 16-char Gmail app password. Used when the OAuth values are empty.
GMAIL_APP_PASSWORD=

# Gmail API path (HTTPS, works on Render Free). Create an OAuth client in Google
# Cloud with the scope https://www.googleapis.com/auth/gmail.send and obtain a
# refresh token. When all three are set, email is sent via the Gmail API instead
# of SMTP. Publish the OAuth consent screen so the refresh token does not expire.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Use server/serviceAccountKey.json locally, or a Render secret file at
# /etc/secrets/serviceAccountKey.json. FIREBASE_SERVICE_ACCOUNT is an alternative
# containing the service-account JSON, configured privately on the backend.
FIREBASE_SERVICE_ACCOUNT=

# Gatekeeper credentials are required only for staff check-in access.
ADMIN_KEY=
ADMIN_SECRET=
