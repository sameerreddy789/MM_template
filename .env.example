# Public backend URL used in production. Local Vite forwards /api to port 4000.
VITE_BACKEND_URL=https://mohanamantra-backend.onrender.com

# Registration availability is read from the backend. It stays closed until
# REGISTRATIONS_OPEN=true and the live backend configuration is ready.
# Public builds reject test checkout; local npm run dev allows test payments.

# Razorpay key IDs are returned by the backend when an order is created.
# Never put RAZORPAY_KEY_SECRET, webhook secrets, Gmail passwords, ticket-signing
# secrets, or a Firebase service-account private key in VITE_ variables.
