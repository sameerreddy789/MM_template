# ==============================================================================
# Strix Environment Configuration for MohanaMantra
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp testing/.env.example testing/.env
#
# Then source it before running scans:
#   source testing/.env
#
# ⚠️  NEVER commit the .env file — it contains secrets!
# ==============================================================================

# --- LLM Provider Configuration ---
# Choose your LLM provider and set the API key.
# Supported providers: openai, anthropic, google, openrouter, etc.
# See: https://docs.strix.ai/llm-providers/overview

# Option 1: OpenAI
# export STRIX_LLM="openai/gpt-4o"
# export LLM_API_KEY="sk-..."

# Option 2: Anthropic (Claude)
# export STRIX_LLM="anthropic/claude-sonnet-4-20250514"
# export LLM_API_KEY="sk-ant-..."

# Option 3: Google (Gemini)
# export STRIX_LLM="google/gemini-2.5-pro"
# export LLM_API_KEY="AI..."

# --- Strix Cloud API (optional, for managed scans) ---
# Get your token from: https://app.strix.ai → Settings → API Access
# export STRIX_API_TOKEN="stx_..."
